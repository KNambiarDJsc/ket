# Copy this file to .env and fill in real values. .env is gitignored --
# never commit real API keys.

# --- Local Ollama (default; no .env needed if you're just using this) ---
# VERIFORGE_LLM_PROVIDER=ollama
# VERIFORGE_LLM_MODEL=llama3.2:3b
# VERIFORGE_OLLAMA_HOST=http://localhost:11434

# --- Hosted OpenAI-compatible endpoint (e.g. an internal LiteLLM proxy) ---
# VERIFORGE_LLM_PROVIDER=openai
# VERIFORGE_LLM_MODEL=gpt-oss-20b
# VERIFORGE_OPENAI_BASE_URL=http://<host>:4000/v1
# VERIFORGE_OPENAI_API_KEY=sk-...
